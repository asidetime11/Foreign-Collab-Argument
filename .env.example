DJANGO_SECRET_KEY=换成一个随机长字符串
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=你的域名

# SQLite 路径由 docker-compose 通过环境变量注入，此处留空即可
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

DUBRIFY_BASE_URL=https://api.dubrify.com/v1
DUBRIFY_API_KEY=
DEFAULT_CHAT_MODEL=deepseek-r1
DEFAULT_TRANSCRIBE_MODEL=whisper-1
